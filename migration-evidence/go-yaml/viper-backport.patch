From 5fe269f5aadefd35b72db8318cea32e3ad6aa013 Mon Sep 17 00:00:00 2001
From: "SUSE Observability AI (POC)" <suse-observability-ops@suse.com>
Date: Thu, 1 Oct 2026 07:13:30 +0000
Subject: [PATCH] Backport maintained YAML v2 without removing HCL APIs

Change the parser import and requirement on Viper v1.14.0 only;
retain HCL, filesystem and mapstructure APIs. The parser requires Go 1.15.
Reconstructed after runner loss; the previous local commit e2d44b5 was
not pushed and is unavailable. Fresh Datadog HCL/config and Viper
HCL/YAML read/write, merge and unmarshal tests pass in the workspace.
Original-source pflag failure was recorded in the earlier session.

Tracking: https://github.com/StackVista/stackstate/issues/717
---
 go.mod   | 4 ++--
 go.sum   | 2 ++
 viper.go | 2 +-
 3 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/go.mod b/go.mod
index f839cd6..bf8ba83 100644
--- a/go.mod
+++ b/go.mod
@@ -3 +3 @@ module github.com/DataDog/viper
-go 1.14
+go 1.15
@@ -31,0 +32 @@ require (
+	go.yaml.in/yaml/v2 v2.4.4
@@ -37 +37,0 @@ require (
-	gopkg.in/yaml.v2 v2.2.5
diff --git a/go.sum b/go.sum
index 5d088c9..7e37497 100644
--- a/go.sum
+++ b/go.sum
@@ -212,0 +213,2 @@ go.uber.org/zap v1.14.0/go.mod h1:zwrFLgMcdUuIBviXEYEH1YKNaOBnKXsx2IPda5bBwHM=
+go.yaml.in/yaml/v2 v2.4.4 h1:tuyd0P+2Ont/d6e2rl3be67goVK4R6deVxCUX5vyPaQ=
+go.yaml.in/yaml/v2 v2.4.4/go.mod h1:gMZqIpDtDqOfM0uNfy0SkpRhvUryYH0Z6wdMYcacYXQ=
diff --git a/viper.go b/viper.go
index abc77e3..96dbbd3 100644
--- a/viper.go
+++ b/viper.go
@@ -35 +35 @@ import (
-	yaml "gopkg.in/yaml.v2"
+	yaml "go.yaml.in/yaml/v2"
-- 
2.51.0
